+@pytest.mark.asyncio
+@pytest.mark.parametrize("thinking", [None, "enabled", "disabled"])
+async def test_diagnostic_provider_records_effective_thinking_mode(thinking):
+    chunk = {
+        "choices": [
+            {
+                "index": 0,
+                "delta": {"reasoning_content": "", "content": "ok"},
+                "finish_reason": "stop",
+            }
+        ]
+    }
+    body = f"data: {json.dumps(chunk)}\n\ndata: [DONE]\n\n"
+    client = httpx.AsyncClient(
+        transport=httpx.MockTransport(lambda request: httpx.Response(200, text=body))
+    )
+    provider = OpenAICompatibleProvider(
+        base_url="https://api.deepseek.com/v1", api_key="test", client=client
+    )
+    events = [
+        e
+        async for e in provider.stream(
+            ModelRequest(
+                model="deepseek-v4-flash",
+                messages=[ChatMessage(role=Role.USER, content="ok")],
+                thinking=thinking,
+            )
+        )
+    ]
+    await client.aclose()
+    assert events[-1].provider_metadata["thinking_mode"] == (thinking or "enabled")
