+@pytest.mark.parametrize("reasoning", [None, "", "inspect"])
+def test_diagnostic_empty_reasoning_preserves_thinking_chain(reasoning):
+    provider = OpenAICompatibleProvider(base_url="https://api.deepseek.com/v1", api_key="test")
+    request = ModelRequest(
+        model="deepseek-v4-flash",
+        messages=[
+            ChatMessage(
+                role=Role.ASSISTANT,
+                reasoning_content=reasoning,
+                tool_calls=[ToolCall(id="call-1", name="read_file", arguments={"path": "a"})],
+            )
+        ],
+    )
+    payload = provider._payload(request)
+    if reasoning is None:
+        assert payload["thinking"] == {"type": "disabled"}
+        assert "reasoning_content" not in payload["messages"][0]
+    else:
+        assert "thinking" not in payload
+        assert payload["messages"][0]["reasoning_content"] == reasoning
+
