+@pytest.mark.asyncio
+@pytest.mark.parametrize("thinking_mode", ["enabled", "disabled", None])
+async def test_diagnostic_agent_preserves_empty_thinking_turn(tmp_path: Path, thinking_mode):
+    (tmp_path / "input.txt").write_text("evidence")
+    first_turn = tool_turn("read-1", "read_file", '{"path":"input.txt"}')
+    first_turn[-1] = first_turn[-1].model_copy(
+        update={"provider_metadata": {"thinking_mode": thinking_mode} if thinking_mode else {}}
+    )
+    provider = ScriptedProvider(
+        [
+            first_turn,
+            [
+                ModelEvent(kind=ModelEventKind.TEXT_DELTA, text="done"),
+                ModelEvent(kind=ModelEventKind.FINISH, finish_reason="stop"),
+            ],
+        ]
+    )
+    runner, store = make_test_runner(tmp_path, provider, tools=[ReadFileTool()])
+    result = await runner.run(RunRequest(prompt="inspect"))
+    assert result.status == "completed"
+    message = next(
+        m for m in provider.requests[1].messages if m.role == Role.ASSISTANT and m.tool_calls
+    )
+    if thinking_mode == "enabled":
+        assert message.reasoning_content == ""
+        assert message.to_openai()["reasoning_content"] == ""
+    else:
+        assert message.reasoning_content is None
+        assert "reasoning_content" not in message.to_openai()
+    store.close()
